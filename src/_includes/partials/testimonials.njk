{% from "partials/icon.njk" import icon %}
{# Testimonials carousel — reused across service pages #}
<section class="relative overflow-hidden bg-navy-950 py-20 lg:py-28">
  <div class="pointer-events-none absolute inset-0 bg-grid-pattern bg-[size:44px_44px] opacity-30"></div>
  <div class="pointer-events-none absolute left-1/2 top-0 h-72 w-72 -translate-x-1/2 rounded-full bg-gold-500/10 blur-3xl"></div>

  <div class="reveal relative mx-auto max-w-4xl px-6 text-center lg:px-12">
    <span class="eyebrow-dark">Testimonials</span>
    <h2 class="mt-5 text-3xl font-bold text-white sm:text-4xl">Customers love us.</h2>
    <p class="mt-4 text-lg text-slate-300">TUM Grand Venture is trusted by thousands of businesses. See what they have said about us!</p>
  </div>

  <div class="reveal relative mx-auto mt-14 max-w-4xl px-6 lg:px-12" data-carousel>
    <div class="overflow-hidden rounded-3xl">
      <div class="flex transition-transform duration-500 ease-out" data-carousel-track>
        <div class="w-full flex-none px-2" data-carousel-slide>
          <div class="rounded-3xl bg-white/5 p-8 ring-1 ring-white/10 sm:p-10">
            <div class="flex gap-1 text-gold-400">
              {% for i in range(5) %}{{ icon("star", "h-5 w-5") }}{% endfor %}
            </div>
            <p class="mt-5 text-lg leading-relaxed text-slate-100">&ldquo;Thank you to the TUM Grand Venture team for creating such a remarkable service. I look forward to continuing to use it in the future.&rdquo;</p>
            <div class="mt-6 flex items-center gap-4">
              <img src="/img/testimonial-1.webp" alt="Albert Brown" class="h-12 w-12 rounded-full object-cover ring-2 ring-gold-400/50" width="48" height="48" loading="lazy" />
              <div>
                <p class="font-semibold text-white">Albert Brown</p>
                <p class="text-sm text-slate-400">Verified Customer</p>
              </div>
            </div>
          </div>
        </div>
        <div class="w-full flex-none px-2" data-carousel-slide>
          <div class="rounded-3xl bg-white/5 p-8 ring-1 ring-white/10 sm:p-10">
            <div class="flex gap-1 text-gold-400">
              {% for i in range(5) %}{{ icon("star", "h-5 w-5") }}{% endfor %}
            </div>
            <p class="mt-5 text-lg leading-relaxed text-slate-100">&ldquo;Overall, I wholeheartedly recommend TUM Grand Venture to all. It&rsquo;s been a game-changer for me, and I&rsquo;m sure it will be for others too.&rdquo;</p>
            <div class="mt-6 flex items-center gap-4">
              <img src="/img/testimonial-2.webp" alt="Julio Collins" class="h-12 w-12 rounded-full object-cover ring-2 ring-gold-400/50" width="48" height="48" loading="lazy" />
              <div>
                <p class="font-semibold text-white">Julio Collins</p>
                <p class="text-sm text-slate-400">Verified Customer</p>
              </div>
            </div>
          </div>
        </div>
        <div class="w-full flex-none px-2" data-carousel-slide>
          <div class="rounded-3xl bg-white/5 p-8 ring-1 ring-white/10 sm:p-10">
            <div class="flex gap-1 text-gold-400">
              {% for i in range(5) %}{{ icon("star", "h-5 w-5") }}{% endfor %}
            </div>
            <p class="mt-5 text-lg leading-relaxed text-slate-100">&ldquo;I recently had the pleasure of using TUM Grand Venture Service, and I couldn&rsquo;t be more delighted with the results. From start to finish, the experience was exceptional.&rdquo;</p>
            <div class="mt-6 flex items-center gap-4">
              <img src="/img/testimonial-3.webp" alt="John Smith" class="h-12 w-12 rounded-full object-cover ring-2 ring-gold-400/50" width="48" height="48" loading="lazy" />
              <div>
                <p class="font-semibold text-white">John Smith</p>
                <p class="text-sm text-slate-400">Verified Customer</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8 flex items-center justify-center gap-6">
      <button data-carousel-prev aria-label="Previous testimonial" class="flex h-10 w-10 items-center justify-center rounded-full border border-white/15 text-white transition-colors hover:border-gold-400 hover:text-gold-400">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M15 6l-6 6 6 6"/></svg>
      </button>
      <div class="flex items-center gap-2" data-carousel-dots></div>
      <button data-carousel-next aria-label="Next testimonial" class="flex h-10 w-10 items-center justify-center rounded-full border border-white/15 text-white transition-colors hover:border-gold-400 hover:text-gold-400">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M9 6l6 6-6 6"/></svg>
      </button>
    </div>
  </div>
</section>
