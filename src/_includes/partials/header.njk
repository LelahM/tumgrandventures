        <div class="invisible absolute left-1/2 top-full z-20 w-80 -translate-x-1/2 translate-y-2 opacity-0 transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
          <div class="mt-2 overflow-hidden rounded-2xl bg-white p-2 shadow-card-hover ring-1 ring-slate-900/5">
            <a href="/services/" class="dropdown-link">
              <span class="dropdown-icon">{{ icon("grid") }}</span>
              <span><span class="block font-semibold text-navy-900">All Services</span><span class="block text-xs text-slate-500">See our full solution overview</span></span>
            </a>
            <a href="/business-internet-solutions/" class="dropdown-link">
              <span class="dropdown-icon">{{ icon("signal") }}</span>
              <span><span class="block font-semibold text-navy-900">Business Internet Solutions</span><span class="block text-xs text-slate-500">Fiber, EoC, fixed wireless &amp; more</span></span>
            </a>
            <a href="/hosted-voip/" class="dropdown-link">
              <span class="dropdown-icon">{{ icon("phone") }}</span>
              <span><span class="block font-semibold text-navy-900">Hosted VoIP Solutions</span><span class="block text-xs text-slate-500">Unified communications, anywhere</span></span>
            </a>
            <a href="/management-consulting/" class="dropdown-link">
              <span class="dropdown-icon">{{ icon("briefcase") }}</span>
              <span><span class="block font-semibold text-navy-900">Management Consulting</span><span class="block text-xs text-slate-500">Carrier-neutral guidance</span></span>
            </a>
            <a href="/crm-integration/" class="dropdown-link">
              <span class="dropdown-icon">{{ icon("sync") }}</span>
              <span><span class="block font-semibold text-navy-900">CRM Integration</span><span class="block text-xs text-slate-500">Know who's calling, every time</span></span>
            </a>
          </div>
        </div>
      </li>
      <li><a href="/contact/" class="nav-link">Contact</a></li>
      <li><a href="/faqs/" class="nav-link">FAQs</a></li>
    </ul>

    <div class="hidden items-center gap-4 lg:flex">
      <a href="tel:+18135904080" class="flex items-center gap-2 text-sm font-semibold text-navy-800">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 text-gold-500"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.24.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z"/></svg>
        (813) 590-4080
      </a>
      <a href="/contact/" class="btn bg-navy-900 text-white shadow-soft hover:bg-navy-800 hover:-translate-y-0.5">Get Started Now</a>
