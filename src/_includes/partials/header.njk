      <a href="/about/" class="mobile-link">About</a>
      <button id="mobile-services-toggle" class="mobile-link flex w-full items-center justify-between" aria-expanded="false">
        Services
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 transition-transform" id="mobile-services-chevron"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 10.94l3.71-3.71a.75.75 0 1 1 1.06 1.06l-4.24 4.25a.75.75 0 0 1-1.06 0L5.21 8.29a.75.75 0 0 1 .02-1.08Z" clip-rule="evenodd"/></svg>
      </button>
      <div id="mobile-services-menu" class="hidden space-y-1 pl-4">
        <a href="/services/" class="mobile-sublink">All Services</a>
        <a href="/business-internet-solutions/" class="mobile-sublink">Business Internet Solutions</a>
        <a href="/hosted-voip/" class="mobile-sublink">Hosted VoIP Solutions</a>
        <a href="/management-consulting/" class="mobile-sublink">Management Consulting</a>
        <a href="/crm-integration/" class="mobile-sublink">CRM Integration</a>
